{
    "name": "yiero_web_scripts",
    "private": true,
    "version": "1.0.0",
    "description": "",
    "scripts": {
        "build": "tsx script/workspace/cli/build.ts",
        "build:all": "tsx script/workspace/cli/build.ts --all",
        "new:script": "tsx script/workspace/cli/new-script.ts",
        "check:template": "tsx script/workspace/cli/check-template.ts",
        "test": "tsx --test script/workspace/test/*.test.ts",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "verify": "pnpm typecheck && pnpm check:template && pnpm test",
        "update:readme": "npx tsx script/updateReadme/updateReadme.ts",
        "format": "biome format --write ."
    },
    "keywords": [],
    "author": "Yiero",
    "license": "LGPL-3.0-or-later",
    "devDependencies": {
        "@biomejs/biome": "2.4.12",
        "@types/node": "^25.5.0",
        "tsx": "^4.21.0",
        "typescript": "^6.0.2"
    }
}
