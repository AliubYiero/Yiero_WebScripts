{
    "name": "yiero_web_scripts",
    "private": true,
    "version": "1.0.0",
    "description": "",
    "scripts": {
        "build": "tsx script/workspace/cli/build.ts",
        "build:all": "tsx script/workspace/cli/build.ts --all",
        "new:script": "tsx script/workspace/cli/new-script.ts",
        "check:template": "tsx script/workspace/cli/check-template.ts",
        "check:tags": "tsx script/release/cli/check-tags.ts",
        "release:tag": "tsx script/release/cli/tag.ts",
        "release:retag": "tsx script/release/cli/retag.ts",
        "test": "tsx --test script/workspace/test/*.test.ts script/release/test/*.test.ts script/browser/test/*.test.ts",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "verify": "pnpm typecheck && pnpm check:template && pnpm check:tags && pnpm test",
        "update:readme": "npx tsx script/updateReadme/updateReadme.ts",
        "format": "biome format --write .",
        "browser:setup": "tsx script/browser/cli.ts setup",
        "browser:launch": "tsx script/browser/cli.ts launch",
        "browser:stop": "tsx script/browser/cli.ts stop",
        "browser:serve": "tsx script/browser/cli.ts serve",
        "browser:pair": "tsx script/browser/cli.ts pair",
        "browser:status": "tsx script/browser/cli.ts status",
        "browser:attach": "tsx script/browser/cli.ts attach",
        "browser:doctor": "tsx script/browser/cli.ts doctor"
    },
    "keywords": [],
    "author": "Yiero",
    "license": "LGPL-3.0-or-later",
    "devDependencies": {
        "@biomejs/biome": "2.4.12",
        "@types/node": "^25.5.0",
        "playwright-core": "^1.64.1",
        "tsx": "^4.21.0",
        "typescript": "^6.0.2"
    }
}
