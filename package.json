{
    "name": "yiero_web_scripts",
    "private": true,
    "version": "1.0.0",
    "description": "",
    "scripts": {
        "build": "tsx script/workspace/cli/build.ts",
        "build:all": "tsx script/workspace/cli/build.ts --all",
        "commit": "tsx script/workspace/cli/commit.ts",
        "push": "tsx script/workspace/cli/push.ts",
        "new:script": "tsx script/workspace/cli/new-script.ts",
        "check:template": "tsx script/workspace/cli/check-template.ts",
        "check:tags": "tsx script/release/cli/check-tags.ts",
        "check:biome": "biome check script/workspace script/release",
        "release:tag": "tsx script/release/cli/tag.ts",
        "release:retag": "tsx script/release/cli/retag.ts",
        "test": "tsx --test script/workspace/test/*.test.ts script/release/test/*.test.ts script/browser/test/*.test.ts && node --test script/browser/test/mcp-bridge.test.mjs",
        "test:libs": "tsx script/workspace/cli/check-libs.ts test",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "typecheck:libs": "tsx script/workspace/cli/check-libs.ts typecheck",
        "verify": "pnpm typecheck && pnpm typecheck:libs && pnpm check:biome && pnpm check:template && pnpm check:tags && pnpm test:libs && pnpm test",
        "update:readme": "npx tsx script/updateReadme/updateReadme.ts",
        "format": "biome format --write .",
        "browser:setup": "tsx script/browser/cli.ts setup",
        "browser:launch": "tsx script/browser/cli.ts launch",
        "browser:stop": "tsx script/browser/cli.ts stop",
        "browser:serve": "tsx script/browser/cli.ts serve",
        "browser:pair": "tsx script/browser/cli.ts pair",
        "browser:status": "tsx script/browser/cli.ts status",
        "browser:attach": "tsx script/browser/cli.ts attach",
        "browser:doctor": "tsx script/browser/cli.ts doctor",
        "browser:mcp": "node script/browser/mcp-bridge.mjs",
        "browser:mcp:config": "node script/browser/mcp-bridge.mjs --print-config dsh",
        "browser:mcp:config:json": "node script/browser/mcp-bridge.mjs --print-config json",
        "browser:mcp:check": "node script/browser/mcp-bridge.mjs --check"
    },
    "keywords": [],
    "author": "Yiero",
    "license": "GPL-3.0-only",
    "devDependencies": {
        "@biomejs/biome": "2.4.12",
        "@types/node": "^25.5.0",
        "playwright-core": "^1.64.1",
        "tsx": "^4.21.0",
        "typescript": "^6.0.2"
    }
}
