{
    "name": "@yiero/gmlib",
    "author": "Yiero",
    "version": "0.4.7",
    "description": "GM Lib for Tampermonkey/ScriptCat",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "types": "./dist/index.d.ts",
    "files": [
        "dist",
        "LICENSE"
    ],
    "scripts": {
        "dev": "rslib build --watch",
        "build": "rslib build",
